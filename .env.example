# .env.example — copy this file to .env and fill in your real values.
# NEVER commit the .env file (it is blocked by .gitignore).

APP_NAME=MIRAI API
ENV=development

# Optional absolute path to a writable, service-owned snapshot directory.
# CTF_SNAPSHOT_DIR=

# Phase 4, approved local Linux image ID from docker image inspect.
# CTF_VALIDATION_IMAGE=sha256:<full-image-id>
# Optional absolute paths owned by the local operator.
# CTF_VALIDATION_WHEELHOUSE=
# CTF_VALIDATION_REPORT_DIR=

# Phase 6, optional absolute path to the official Harbor 0.25.0 executable.
# CTF_HARBOR_EXECUTABLE=
# Optional operator-owned local directory for evaluation evidence.
# CTF_EVALUATION_DIR=
# OPENAI_API_KEY=        # Host-side evaluation provider only.
# HF_TOKEN=              # Hugging Face token with Inference Providers permission.

# ── Gemini API ────────────────────────────────────────────────────
# Used for generation and Gemini coding-agent evaluation.
GEMINI_API_KEY=your_gemini_key_here
# Optional model override shared by task, solution and test generation.
# GEMINI_MODEL=gemini-3.8-flash

# Phase 7. Use a local, service-owned directory outside uploaded workspaces.
# CTF_STATE_DIR=
CTF_SHARED_MODE=0
# Shared mode uses HTTPS and explicit trusted origin(s), including the browser app origin.
# CTF_ALLOWED_ORIGINS=https://task-factory.example
# Configure unique, random, URL-safe tokens of 32–128 characters through service secrets.
# CTF_ACCESS_TOKENS={"operator":"replace-with-a-random-token"}
CTF_REQUESTS_PER_MINUTE=240
CTF_MODEL_REQUESTS_PER_DAY=64
CTF_GLOBAL_MODEL_REQUESTS_PER_DAY=256
# Shared live evaluations require an explicit comma-separated model allowlist.
# CTF_AGENT_MODELS=openai/your-approved-model-id
